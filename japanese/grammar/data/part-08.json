       "note": "前に接辞書形",
       "bad": null
      },
      {
       "en": "来年日本へ行くつもりです。",
       "reading": "らいねん にほんへ いくつもりです。",
       "zh": "我打算明年去日本。",
       "note": null,
       "bad": null
      }

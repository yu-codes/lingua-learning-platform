{
  "title": "餐廳用餐",
  "description": "在餐廳用餐時的常用對話",
  "category": "daily-life",
  "sentences": [
    { "en": "A table for two, please.", "zh": "請給我們兩位的座位。" },
    { "en": "Do you have a reservation?", "zh": "請問您有訂位嗎？" },
    { "en": "Could I see the menu, please?", "zh": "可以給我菜單嗎？" },
    { "en": "What do you recommend?", "zh": "你推薦什麼？" },
    { "en": "What's today's special?", "zh": "今天的特餐是什麼？" },
    { "en": "I'm ready to order.", "zh": "我準備好要點餐了。" },
    { "en": "Could we have some more water, please?", "zh": "可以再給我們一些水嗎？" },
    { "en": "Excuse me, could I get the check, please?", "zh": "不好意思，可以買單嗎？" },
    { "en": "Is this seat taken?", "zh": "這個位子有人坐嗎？" },
    { "en": "How long is the wait?", "zh": "需要等多久？" },
    { "en": "Can we sit by the window?", "zh": "我們可以坐窗邊嗎？" },
    { "en": "Do you have a kids' menu?", "zh": "你們有兒童菜單嗎？" },
    { "en": "I have a food allergy.", "zh": "我有食物過敏。" },
    { "en": "Does this dish contain nuts?", "zh": "這道菜有堅果嗎？" },
    { "en": "Could you bring us some napkins?", "zh": "可以給我們一些餐巾紙嗎？" },
    { "en": "The food was delicious.", "zh": "食物非常美味。" },
    { "en": "We'd like separate checks, please.", "zh": "我們想要分開結帳。" },
    { "en": "Is the tip included?", "zh": "小費有包含在內嗎？" },
    { "en": "Can I get a refill on my coffee?", "zh": "我的咖啡可以續杯嗎？" },
    { "en": "I'd like to make a reservation for tonight.", "zh": "我想預約今晚的位子。" },
    { "en": "Could we get a booth instead?", "zh": "我們可以換包廂的座位嗎？" },
    { "en": "What are your opening hours?", "zh": "你們的營業時間是什麼時候？" },
    { "en": "Is there a dress code?", "zh": "有服裝規定嗎？" },
    { "en": "Do you have vegetarian options?", "zh": "你們有素食選項嗎？" },
    { "en": "This isn't what I ordered.", "zh": "這不是我點的。" },
    { "en": "Could you heat this up a bit more?", "zh": "可以再加熱一下嗎？" },
    { "en": "Can I get a doggy bag?", "zh": "可以幫我打包嗎？" },
    { "en": "Where is the restroom?", "zh": "洗手間在哪裡？" },
    { "en": "We're celebrating a birthday tonight.", "zh": "我們今晚在慶祝生日。" },
    { "en": "Thank you, everything was wonderful.", "zh": "謝謝，一切都很棒。" }
  ]
}

{
  "title": "日常問候",
  "description": "日常生活中常用的問候與寒暄用語",
  "category": "daily-life",
  "sentences": [
    { "en": "Good morning! How are you?", "zh": "早安！你好嗎？" },
    { "en": "Hey, long time no see!", "zh": "嘿，好久不見！" },
    { "en": "How's it going?", "zh": "最近怎麼樣？" },
    { "en": "Nice to meet you.", "zh": "很高興認識你。" },
    { "en": "How have you been?", "zh": "你最近過得如何？" },
    { "en": "Good evening! How was your day?", "zh": "晚上好！你今天過得怎麼樣？" },
    { "en": "What's up?", "zh": "怎麼了？/ 最近好嗎？" },
    { "en": "It's great to see you again.", "zh": "很高興再次見到你。" },
    { "en": "How's everything going?", "zh": "一切都還好嗎？" },
    { "en": "Good afternoon! Are you having a good day?", "zh": "午安！你今天過得好嗎？" },
    { "en": "Hi there! What have you been up to?", "zh": "嗨！你最近在忙什麼？" },
    { "en": "I'm doing well, thanks for asking.", "zh": "我很好，謝謝你的關心。" },
    { "en": "Not bad, how about you?", "zh": "還不錯，你呢？" },
    { "en": "It's been a while! How are things?", "zh": "好一陣子了！最近如何？" },
    { "en": "Have a great weekend!", "zh": "祝你週末愉快！" },
    { "en": "See you later! Take care.", "zh": "待會見！保重。" },
    { "en": "Good night! Sleep well.", "zh": "晚安！睡個好覺。" },
    { "en": "How's your family doing?", "zh": "你家人都好嗎？" },
    { "en": "I hope you're doing well.", "zh": "希望你一切都好。" },
    { "en": "It was nice talking to you.", "zh": "很高興和你聊天。" },
    { "en": "Have a nice day!", "zh": "祝你有美好的一天！" },
    { "en": "What's new with you?", "zh": "你有什麼新鮮事嗎？" },
    { "en": "I'm so glad I ran into you.", "zh": "很高興碰到你。" },
    { "en": "How's work going?", "zh": "工作還順利嗎？" },
    { "en": "Are you keeping busy?", "zh": "你最近忙嗎？" },
    { "en": "Say hi to your family for me.", "zh": "幫我向你家人問好。" },
    { "en": "Let's catch up soon.", "zh": "我們找時間聚聚吧。" },
    { "en": "I haven't seen you in ages!", "zh": "我好久沒看到你了！" },
    { "en": "Take it easy!", "zh": "放輕鬆！/ 別太累了！" },
    { "en": "See you tomorrow!", "zh": "明天見！" }
  ]
}
